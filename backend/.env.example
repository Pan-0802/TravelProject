# 在 IDE 运行配置中设置环境变量；Spring Boot 不会自动加载本文件。
DB_URL=jdbc:mysql://localhost:3306/travel_planner_course?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=replace-me
# 至少 32 字节的随机密钥
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://localhost:5173
AMAP_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# 本机 MySQL8-实验 使用 3307 时，将上面的 DB_URL 端口改为3307。
# AI_MODEL 应填写模型列表返回的 id，例如已验证可用的 deepseek-flash。
