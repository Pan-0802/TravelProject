# 复制为 .env.local，填写自己的配置。scripts/Start-Backend.ps1 会加载它；IDEA可继续使用环境变量。
DB_URL=jdbc:mysql://localhost:3306/travel_planner_course_demo?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=replace-me
# 至少 32 字节的随机密钥
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5175,http://127.0.0.1:5175
AMAP_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# 按天数分配完整方案输出上限；普通问答最多3072，最终受此上限约束。
AI_MAX_OUTPUT_TOKENS=16384
# 高德POI搜索的串行队列，最小请求间隔（毫秒）。
AMAP_INTERVAL_MILLIS=650
# 如果自己的 MySQL 使用 3307，将上面的 DB_URL 端口改为3307。
# AI_MODEL 应填写模型列表返回的 id，例如已验证可用的 deepseek-flash。
