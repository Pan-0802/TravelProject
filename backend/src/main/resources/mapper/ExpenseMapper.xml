<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.mapper.ExpenseMapper">
  <select id="find" resultType="com.travel.domain.Expense">SELECT * FROM `expense` WHERE `expense_id` = #{id}</select>
  <select id="lock" resultType="com.travel.domain.Expense">SELECT * FROM `expense` WHERE `expense_id` = #{id} FOR UPDATE</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="expenseId">
    INSERT INTO `expense` (`trip_id`, `category`, `amount`, `spent_on`, `description`)
    VALUES (#{tripId}, #{category}, #{amount}, #{spentOn}, #{description})
  </insert>
  <update id="update">UPDATE `expense` SET `trip_id` = #{tripId}, `category` = #{category}, `amount` = #{amount}, `spent_on` = #{spentOn}, `description` = #{description} WHERE `expense_id` = #{expenseId}</update>
  <delete id="delete">DELETE FROM `expense` WHERE `expense_id` = #{id}</delete>
</mapper>
