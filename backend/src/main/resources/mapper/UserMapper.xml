<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.mapper.UserMapper">
  <select id="find" resultType="com.travel.domain.User">SELECT * FROM `user` WHERE `user_id` = #{id}</select>
  <select id="lock" resultType="com.travel.domain.User">SELECT * FROM `user` WHERE `user_id` = #{id} FOR UPDATE</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="userId">
    INSERT INTO `user` (`username`, `password_hash`, `nickname`)
    VALUES (#{username}, #{passwordHash}, #{nickname})
  </insert>
  <update id="update">UPDATE `user` SET `username` = #{username}, `password_hash` = #{passwordHash}, `nickname` = #{nickname} WHERE `user_id` = #{userId}</update>
  <delete id="delete">DELETE FROM `user` WHERE `user_id` = #{id}</delete>
</mapper>
