{
  "name": "travel-planner-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "个人旅行记录与智能规划系统 - 前端（Vue 3 + Element Plus + ECharts）",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:boundaries": "playwright test boundaries.spec.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.16.11",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
